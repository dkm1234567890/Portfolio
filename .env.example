# Copy this file to `.env` and fill in your EmailJS values.
# These end up in the built JS bundle and are visible to anyone who opens
# devtools — that's expected for EmailJS. The account's domain allowlist and
# rate limits are the actual protection, not secrecy of these IDs.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
